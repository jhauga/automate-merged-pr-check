# Copy this file to .env in the folder auto-check config path names, and fill
# in the values. .env is git-ignored.
# auto-check loads .env at start-up and never overrides a variable that is already set.

# Password for the email account the settings name (notify.email.smtp).
AUTO_CHECK_SMTP_PASSWORD=

# Shared secret sent with webhook notifications (notify.webhook).
AUTO_CHECK_WEBHOOK_SECRET=

# A test folder's own .env can hold the variable its test-configuration.md
# names under Password, such as AUTO_CHECK_EMAIL_PASSWORD.
